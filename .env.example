# =============================================================================
# AI Channel Publisher — environment template
# Copy to `.env` and fill every value. Never commit the real `.env` to git.
# All values are read from the SERVER environment (or the host secret manager).
# The VITE_* values are inlined into the client bundle at build time.
# =============================================================================

# --- Node / runtime ----------------------------------------------------------
# Comma-free string; leave as-is. The Docker image defaults to 3000.
PORT=3000
NODE_ENV=production

# --- Required for production startup (assertRequiredEnv fails fast) ----------
# Application identifier (opaque; used to namespace sessions/cookies).
VITE_APP_ID=ai-channel-publisher

# Signs login-session JWTs. Generate a long random value, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-to-a-long-random-value

# MySQL / TiDB connection string. Example:
#   mysql://user:password@host:3306/ai_channel_publisher?ssl-mode=REQUIRED
DATABASE_URL=mysql://user:password@localhost:3306/ai_channel_publisher

# Local administrator account. The password is stored as a PBKDF2 hash, never
# as plaintext. Generate it with: pnpm exec tsx scripts/generate-admin-password-hash.ts
ADMIN_USER_ID=local-admin
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Administrator
ADMIN_PASSWORD_HASH=pbkdf2$replace-me

# --- Telegram publishing (optional at boot, required to actually publish) ----
# Bot token from @BotFather. Never expose this to the browser.
TELEGRAM_BOT_TOKEN=

# The channel the bot publishes to. Can also be changed later in the web UI
# (Settings → Channel & language); this value only seeds the first run.
TELEGRAM_CHANNEL_HANDLE=@your_channel

# Arbitrary secret sent with the Telegram webhook (`X-Telegram-Bot-Api-Secret-Token`).
# Required for engagement tracking to work. Same rules as JWT_SECRET.
TELEGRAM_WEBHOOK_SECRET=

# --- LLM provider (required to generate posts) -------------------------------
# Any OpenAI-compatible provider. The app calls /v1/chat/completions.
# These act as DEFAULTS — you can also set base URL, key and model in the web
# UI (Settings → AI model & API key). UI values take precedence and the key is
# stored AES-256-GCM encrypted in your database.
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=change-me
LLM_MODEL=gpt-4o-mini

# --- Secret storage ----------------------------------------------------------
# Optional dedicated encryption key for secrets saved from the settings UI.
# Falls back to JWT_SECRET when unset.
SETTINGS_SECRET=

# --- Scheduling --------------------------------------------------------------
# Optional for the Node/Docker deployment. Cloudflare Workers use the Cron
# Triggers in cloudflare/wrangler.toml instead.
# ENABLE_INPROCESS_SCHEDULER=false

# --- Optional analytics (inlined at build time) ------------------------------
# If you self-host Plausible/Umami analytics, set these. Otherwise leave empty.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
