{
  "name": "verborgene-schicht-publisher-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:create": "wrangler d1 create verborgene-schicht-publisher",
    "db:apply:local": "wrangler d1 migrations apply verborgene-schicht-publisher --local",
    "db:apply:remote": "wrangler d1 migrations apply verborgene-schicht-publisher --remote"
  },
  "dependencies": {
    "@trpc/server": "^11.6.0",
    "cookie": "^1.0.2",
    "drizzle-orm": "^0.44.5",
    "jose": "6.1.0",
    "superjson": "^1.13.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "wrangler": "^4.123.0"
  }
}
